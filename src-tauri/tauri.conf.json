{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "扒谱助手",
  "version": "0.1.1",
  "identifier": "com.audio2score",
  "build": {
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "扒谱助手",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../engine/*.py": "engine",
      "../engine/tools/*.py": "engine/tools",
      "runtime": "runtime",
      "../third_party/AutoTranscriber/AutoTranscriber/*.py": "third_party/AutoTranscriber/AutoTranscriber"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
